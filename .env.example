# AI SDK Gateway authentication. In Vercel, OIDC can be supplied automatically.
AI_GATEWAY_API_KEY=

# Evaluation model used to choose a BehaviorID.
JEV_MODEL=typesafe-ai/jev

# Any text-generation model available through the configured AI SDK provider.
LLM_MODEL=openai/gpt-5-mini

MIN_BEHAVIOR_PROBABILITY=0.70
MIN_BEHAVIOR_CONFIDENCE=0.60
MIN_BEHAVIOR_MARGIN=0.15
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
NATS_URL=nats://127.0.0.1:4222
NATS_SUBJECT_IN=behaviorid.predict
NATS_SUBJECT_OUT=behaviorid.predicted
